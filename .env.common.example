# Shared image, application, OIDC, and timeout settings.
MWD_IMAGE_REGISTRY=ghcr.io/skoma93/mvd
MWD_IMAGE_TAG=replace-with-release-or-sha
SYSTEM_HOSTNAME=mwd-machine
WEB_PORT=8080
AUTHENTIK_ISSUER_URL=https://auth.example.invalid/application/o/microwave-drying-machine/
AUTHENTIK_CLIENT_ID=microwave-drying-machine
AUTHENTIK_CLIENT_SECRET=replace-with-private-client-secret
AUTHENTIK_REDIRECT_URI=https://mwd.example.invalid/auth/callback
AUTHENTIK_POST_LOGOUT_REDIRECT_URI=https://mwd.example.invalid/
SESSION_SECRET=replace-with-long-random-session-secret
SESSION_COOKIE_SECURE=true
SESSION_TTL_SECONDS=28800
PLC_UNIT_ID=1
PLC_CONNECT_TIMEOUT_MS=1000
PLC_RESPONSE_TIMEOUT_MS=1000
PLC_POLL_INTERVAL_MS=1000
CAMERA_CONNECT_TIMEOUT_MS=2000
CAMERA_READ_TIMEOUT_MS=10000
CAMERA_MAX_CONNECTIONS=4
