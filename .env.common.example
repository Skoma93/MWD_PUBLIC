# Shared image, application, OIDC, and timeout settings.
MWD_IMAGE_REGISTRY=ghcr.io/skoma93/mvd
MWD_IMAGE_TAG=v0.1.0
SYSTEM_HOSTNAME=mwd-machine
WEB_PORT=8080
AUTHENTIK_PORT=9000
AUTHENTIK_VERSION=2025.12.4
AUTHENTIK_SECRET_KEY=replace-with-long-random-authentik-secret
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=replace-with-random-postgres-password
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.invalid
AUTHENTIK_BOOTSTRAP_PASSWORD=replace-with-authentik-admin-password
AUTHENTIK_BOOTSTRAP_TOKEN=replace-with-random-bootstrap-token
MWD_SIM_ADMIN_PASSWORD=replace-with-initial-admin-password
MWD_SIM_OPERATOR_PASSWORD=replace-with-initial-operator-password
MWD_SIM_VIEWER_PASSWORD=replace-with-initial-viewer-password
MWD_SIM_DISABLED_PASSWORD=replace-with-disabled-user-password
AUTHENTIK_ISSUER_URL=http://replace-with-rpi-ip:9000/application/o/microwave-drying-machine/
AUTHENTIK_CLIENT_ID=microwave-drying-machine
AUTHENTIK_CLIENT_SECRET=replace-with-private-client-secret
AUTHENTIK_REDIRECT_URI=http://replace-with-rpi-ip:8080/auth/callback
AUTHENTIK_POST_LOGOUT_REDIRECT_URI=http://replace-with-rpi-ip:8080/
SESSION_SECRET=replace-with-long-random-session-secret
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
PLC_UNIT_ID=1
PLC_CONNECT_TIMEOUT_MS=1000
PLC_RESPONSE_TIMEOUT_MS=1000
PLC_POLL_INTERVAL_MS=1000
CAMERA_CONNECT_TIMEOUT_MS=2000
CAMERA_READ_TIMEOUT_MS=10000
CAMERA_MAX_CONNECTIONS=4
